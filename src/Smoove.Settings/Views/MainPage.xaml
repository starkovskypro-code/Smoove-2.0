<Page x:Class="Smoove.Settings.Views.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <Style x:Key="ApplicationProfileCard" TargetType="Border">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
  </Page.Resources>
  <NavigationView x:Name="Nav" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="210" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Настройки" Tag="scroll" IsSelected="True">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="TouchPointer" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Программы" Tag="apps">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="AllApps" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Диагностика" Tag="diagnostics">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Help" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="64" HorizontalAlignment="Stretch" Spacing="22">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock x:Name="TitleText" Text="Настройки" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SubtitleText" Text="Настройте движение под свой ритм. Изменения применяются сразу." Style="{StaticResource Hint}" />
          </StackPanel>
          <Button Click="ResetClick" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource DeleteExclusionButton}" ToolTipService.ToolTip="Сбросить настройки" AutomationProperties.Name="Сбросить настройки" x:Name="ResetSettingsButton">
            <FontIcon Glyph="" FontSize="18" Width="18" Height="18" />
          </Button>
        </Grid>
        <InfoBar x:Name="Connection" IsOpen="True" IsClosable="False" Severity="Success" Title="Smoove работает" Message="Закрытие окна оставляет приложение в трее." />
        <StackPanel x:Name="ScrollSection" Spacing="48">
          <ComboBox x:Name="ProfileScope" Header="Настройки для" HorizontalAlignment="Stretch" SelectionChanged="ProfileScopeChanged" AutomationProperties.Name="Настройки для" />
          <TextBlock x:Name="ProfileHint" Style="{StaticResource Hint}" />
          <StackPanel Spacing="20">
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="Плавная прокрутка" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Объединяет шаги колеса в одно непрерывное движение. Горизонтальное колесо и Shift + колесо — по горизонтали. Настройки общие для обеих осей." Style="{StaticResource Hint}" />
              </StackPanel>
              <ToggleSwitch x:Name="Enabled" Grid.Column="1" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="40" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="Changed" AutomationProperties.Name="Плавная прокрутка" />
            </Grid>
            <ComboBox x:Name="EngineChoice" Header="Движок прокрутки" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Changed" AutomationProperties.Name="Движок прокрутки">
              <ComboBoxItem Content="Smoove — основной" />
              <ComboBoxItem Content="Smoothie — экспериментальная модель" />
            </ComboBox>
            <TextBlock x:Name="EngineDescription" Style="{StaticResource Hint}" />
            <ComboBox x:Name="Preset" Header="Характер движения" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="PresetChanged">
              <ComboBoxItem Content="Сбалансированный — мягко и отзывчиво" />
              <ComboBoxItem Content="Тягучий — долгое скольжение" />
            </ComboBox>
          </StackPanel>
          <Grid ColumnSpacing="48" x:Name="SettingsColumns">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="48">
              <StackPanel Spacing="8">
                <TextBlock Text="Скорость" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Расстояние прокрутки" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="DistanceValue" HorizontalAlignment="Right" Grid.Column="1" />
                </Grid>
                <Slider x:Name="Distance" Minimum="0.5" Maximum="4" Value="1" StepFrequency="0.1" ValueChanged="Changed" AutomationProperties.Name="Расстояние прокрутки" />
                <TextBlock Text="Сколько страницы проходит один поворот. Меньше — точнее, больше — быстрее." Style="{StaticResource Hint}" />
                <Grid Margin="0,12,0,0" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Ускорение при быстром вращении" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="AccelerationValue" HorizontalAlignment="Right" Grid.Column="1" />
                </Grid>
                <Slider x:Name="Acceleration" Minimum="0" Maximum="100" Value="60" StepFrequency="5" ValueChanged="Changed" AutomationProperties.Name="Ускорение при быстром вращении" />
                <TextBlock Text="Крутите быстрее — проходите больше за тот же поворот. Медленный скролл остаётся точным. 0% выключает ускорение; свободное колесо не ограничивается." Style="{StaticResource Hint}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8" Grid.Column="1">
              <TextBlock Text="Плавность и инерция" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Темп анимации" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="AnimationTempoValue" HorizontalAlignment="Right" Grid.Column="1" />
              </Grid>
              <Slider x:Name="AnimationTempo" Minimum="0.5" Maximum="8" Value="1" StepFrequency="0.1" ValueChanged="Changed" AutomationProperties.Name="Темп анимации" />
              <TextBlock Text="Ускоряет разгон и остановку вместе. 1× — прежний темп, 8× — в восемь раз быстрее. Расстояние на щелчок сохраняется." Style="{StaticResource Hint}" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сглаживание серии шагов" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SmoothValue" HorizontalAlignment="Right" Grid.Column="1" />
              </Grid>
              <Slider x:Name="Smooth" Minimum="50" Maximum="200" Value="110" StepFrequency="5" ValueChanged="Changed" AutomationProperties.Name="Сглаживание серии шагов" />
              <TextBlock Text="Склеивает щелчки в общую анимацию. Больше — мягче, но движение откликается и останавливается дольше." Style="{StaticResource Hint}" />
              <Grid Margin="0,12,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Разгон" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="RiseValue" HorizontalAlignment="Right" Grid.Column="1" />
              </Grid>
              <Slider x:Name="Rise" Minimum="5" Maximum="300" Value="70" StepFrequency="5" ValueChanged="Changed" AutomationProperties.Name="Разгон" />
              <TextBlock Text="Как мягко набирается скорость. Меньше — быстрее реакция на колесо." Style="{StaticResource Hint}" />
              <Grid Margin="0,12,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Инерция и остановка" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="CoastValue" HorizontalAlignment="Right" Grid.Column="1" />
              </Grid>
              <Slider x:Name="Coast" Minimum="5" Maximum="500" Value="160" StepFrequency="5" ValueChanged="Changed" AutomationProperties.Name="Инерция и остановка" />
              <TextBlock Text="Насколько долго страница скользит после вращения. Больше — тягучее торможение." Style="{StaticResource Hint}" />
            </StackPanel>
          </Grid>
          <Grid x:Name="ExperimentalSettings" Visibility="Collapsed" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
              <TextBlock Text="Расстояние и ускорение" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <TextBlock Text="Расстояние на щелчок" FontWeight="SemiBold" />
              <TextBlock x:Name="ExperimentalDistanceValue" />
              <Slider x:Name="ExperimentalDistance" Minimum="0.5" Maximum="12" Value="8" StepFrequency="0.1" ValueChanged="Changed" AutomationProperties.Name="Эксперимент: расстояние" />
              <TextBlock Text="Множитель расстояния. Для сравнения начните с того же значения, что у основного движка." Style="{StaticResource Hint}" />
              <TextBlock Text="Ускорение от вращения" FontWeight="SemiBold" Margin="0,12,0,0" />
              <TextBlock x:Name="ExperimentalAccelerationValue" />
              <Slider x:Name="ExperimentalAcceleration" Minimum="0" Maximum="2" Value="1" StepFrequency="0.1" ValueChanged="Changed" AutomationProperties.Name="Эксперимент: ускорение" />
              <TextBlock Text="Быстрое колесо увеличивает расстояние. 0 выключает усиление." Style="{StaticResource Hint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Сглаживание и инерция" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <TextBlock Text="Сглаживание" FontWeight="SemiBold" />
              <TextBlock x:Name="ExperimentalSmoothnessValue" />
              <Slider x:Name="ExperimentalSmoothness" Minimum="20" Maximum="200" Value="80" StepFrequency="5" ValueChanged="Changed" AutomationProperties.Name="Эксперимент: сглаживание" />
              <TextBlock Text="Меньше — более прямой отклик. Больше — мягче и дольше." Style="{StaticResource Hint}" />
              <TextBlock Text="Инерция" FontWeight="SemiBold" Margin="0,12,0,0" />
              <TextBlock x:Name="ExperimentalInertiaValue" />
              <Slider x:Name="ExperimentalInertia" Minimum="0" Maximum="2" Value="0.5" StepFrequency="0.1" ValueChanged="Changed" AutomationProperties.Name="Эксперимент: инерция" />
              <TextBlock Text="Удлиняет хвост быстрого вращения и может добавить расстояние. Отдельного темпа анимации у этой модели нет." Style="{StaticResource Hint}" />
            </StackPanel>
          </Grid>
          <Grid ColumnSpacing="48" x:Name="AppearanceColumns">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="10">
              <TextBlock Text="Точность движения" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <ComboBox x:Name="Frequency" Header="Частота обновления прокрутки" SelectedIndex="2" SelectionChanged="Changed">
                <ComboBoxItem Content="60 Гц — экономно" Tag="60" />
                <ComboBoxItem Content="120 Гц" Tag="120" />
                <ComboBoxItem Content="240 Гц" Tag="240" />
                <ComboBoxItem Content="500 Гц — максимальная частота" Tag="500" />
                <ComboBoxItem Content="Авто — по монитору под курсором" Tag="0" />
              </ComboBox>
              <TextBlock Text="Авто: примерно два обновления на кадр монитора, от 60 до 500 Гц. Частота общая для всех профилей. Это не FPS приложения; результат зависит от программы." Style="{StaticResource Hint}" />
            </StackPanel>
            <StackPanel Spacing="12" Grid.Column="1">
              <TextBlock Text="Оформление" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <ComboBox x:Name="ThemeChoice" Header="Тема оформления" SelectedIndex="0" SelectionChanged="ThemeChanged">
                <ComboBoxItem Content="Как в Windows" />
                <ComboBoxItem Content="Светлая" />
                <ComboBoxItem Content="Тёмная" />
              </ComboBox>
            </StackPanel>
          </Grid>
          <StackPanel Spacing="10">
            <TextBlock Text="Запуск приложения" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Запускать при старте Windows" VerticalAlignment="Center" TextWrapping="Wrap" />
              <ToggleSwitch x:Name="Startup" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Width="40" Toggled="StartupChanged" AutomationProperties.Name="Запускать при старте Windows" />
            </Grid>
            <TextBlock Text="При входе в Windows Smoove запускается в трее. Окно настроек не открывается." Style="{StaticResource Hint}" />
            <TextBlock x:Name="StartupMessage" Style="{StaticResource Hint}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="AppsSection" Visibility="Collapsed" Spacing="18">
          <ToggleSwitch x:Name="External" Header="Прокрутка в других программах" IsOn="True" Toggled="Changed" />
          <ComboBox x:Name="AppScope" Header="Где сглаживать прокрутку" SelectedIndex="0" SelectionChanged="Changed" AutomationProperties.Name="Где сглаживать прокрутку">
            <ComboBoxItem Content="Во всех разрешённых программах" />
            <ComboBoxItem Content="Только в выбранных программах" />
          </ComboBox>
          <TextBlock Text="Работает в доступных обычных окнах. Программы с повышенными правами и защищённые экраны используют исходное колесо." Style="{StaticResource Hint}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Выбрать из запущенных" Click="ChooseRunning" />
            <Button Content="Выбрать из установленных" Click="ChooseInstalled" />
          </StackPanel>
          <TextBlock Text="Для программы выберите общие настройки, свой профиль или стандартную прокрутку. Выключенные записи не участвуют в выборе. Распознанные терминалы внутри IDE используют исходное колесо." Style="{StaticResource Hint}" />
          <StackPanel x:Name="ExclusionCards" Spacing="12" />
          <TextBlock Text="Настройки сохраняются автоматически на этом компьютере." Style="{StaticResource Hint}" />
        </StackPanel>
        <StackPanel x:Name="DiagnosticsSection" Visibility="Collapsed" Spacing="14">
          <TextBlock Text="Состояние ввода" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
          <TextBlock x:Name="StatisticsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
          <TextBlock Text="Счётчики помогают найти источник пропусков. Частота событий не подтверждает визуальную совместимость каждой программы." Style="{StaticResource Hint}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </NavigationView>
</Page>
